# ==========================================
# Upemba IoT Backend - Example Environment (.env.example)
# ==========================================

# --- Core Django Settings ---
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*,localhost,127.0.0.1

# --- CORS Settings ---
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- MQTT Broker Settings ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_USER=
MQTT_BROKER_PASSWORD=
MQTT_TELEMETRY_TOPIC=upemba/sensors/+/telemetry

# --- Email Notifications ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True

# --- Predictive Maintenance & ML Forecasting Settings ---
PREDICTION_HISTORY_WINDOW=40
PREDICTION_MIN_HISTORY=10
PREDICTION_HORIZON_STEPS=6
PREDICTION_DEFAULT_INTERVAL_MINUTES=0.5
PREDICTION_HOLT_ALPHA=0.3
PREDICTION_HOLT_BETA=0.1

# --- Background Worker & JWT ---
DJANGO_Q_WORKERS=2
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1
REST_PAGE_SIZE=50
